---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const heading = headings.find(({ depth }) => depth === 1);
const title = page.data.title ?? heading?.text ?? page.id.split('/').at(-1)!.replace(/-/g, ' ');
---

<Layout title={`${title} | GenzPlus`} description={page.data.description ?? title}>
  <article class="markdown-page mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    {!heading && <h1>{title}</h1>}
    <Content />
  </article>
</Layout>

<style>
  .markdown-page {
    line-height: 1.65;
    overflow-wrap: anywhere;
    color: var(--muted-foreground);
  }

  .markdown-page :global(h1),
  .markdown-page :global(h2),
  .markdown-page :global(h3),
  .markdown-page :global(h4),
  .markdown-page :global(h5),
  .markdown-page :global(h6) {
    color: var(--foreground);
    font-family: var(--font-sans);
    font-weight: 500;
    line-height: 1.3;
    text-transform: none;
    margin: 1.5em 0 0.5em;
  }

  .markdown-page :global(h1) { font-size: clamp(2rem, 5vw, 3rem); margin-top: 0; }
  .markdown-page :global(h2) { font-size: 1.5rem; }
  .markdown-page :global(h3) { font-size: 1.25rem; }
  .markdown-page :global(p),
  .markdown-page :global(ul),
  .markdown-page :global(ol) { margin-block: 0.75em; }
  .markdown-page :global(:is(h1, h2, h3, h4, h5, h6) + p) { margin-top: 0; }
  .markdown-page :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .markdown-page :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .markdown-page :global(li) { margin-block: 0.4em; }
  .markdown-page :global(strong) { color: var(--foreground); font-weight: 600; }
  .markdown-page :global(a) { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
  .markdown-page :global(a:focus-visible) { outline: 2px solid var(--primary); outline-offset: 4px; }
  .markdown-page :global(blockquote) { border-left: 3px solid var(--primary); margin-block: 1.5rem; padding-left: 1rem; }
  .markdown-page :global(hr) { border-color: #262626; margin-block: 2rem; }
  .markdown-page :global(code) { font-size: 0.9em; }
  .markdown-page :global(:not(pre) > code) { background: #171717; border-radius: 0.25rem; padding: 0.15em 0.4em; }
  .markdown-page :global(pre) { overflow-x: auto; padding: 1rem; border-radius: 0.75rem; margin-block: 1.5rem; }
  .markdown-page :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 1.5rem; }
  .markdown-page :global(th),
  .markdown-page :global(td) { border: 1px solid #262626; padding: 0.5rem 0.75rem; text-align: left; }
  .markdown-page :global(th) { color: var(--foreground); }
  .markdown-page :global(img) { max-width: 100%; height: auto; border-radius: 0.75rem; }
</style>
