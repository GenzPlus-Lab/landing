---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | GenzPlus" description="This page could not be found.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <h1 class="text-4xl sm:text-6xl">Page not found</h1>
    <p class="mt-4 text-muted-foreground">This page doesn't exist or has moved.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-sm text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >Go to the homepage</a>
  </section>
</Layout>
