---
import Container from '../layout/Container.astro';

interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section aria-labelledby="hero-title" class="relative isolate flex min-h-[calc(100svh-4rem)] items-center justify-center overflow-hidden py-20">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,var(--primary)_0%,transparent_50%)] opacity-10"></div>
    <div class="absolute left-0 top-0 h-full w-1/2 bg-[linear-gradient(90deg,var(--primary)_0%,transparent_100%)] opacity-5"></div>
    <div class="absolute right-0 top-0 h-full w-1/2 bg-[linear-gradient(270deg,var(--accent)_0%,transparent_100%)] opacity-5"></div>
  </div>

  <Container class="text-center">
    <div class="animate-fade-up">
      <p class="mb-6 inline-block rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-xs font-medium tracking-wide text-primary uppercase sm:text-sm">
        Launching soon
      </p>
      <h1 id="hero-title" class="mx-auto max-w-5xl text-balance text-5xl font-normal leading-[0.95] tracking-tight text-foreground sm:text-6xl md:text-7xl lg:text-8xl">
        {title}
      </h1>
      <p class="mx-auto mt-8 max-w-2xl text-balance text-lg text-muted-foreground sm:text-xl">
        {subtitle}
      </p>
    </div>
  </Container>
</section>
